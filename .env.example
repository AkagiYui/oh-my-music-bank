# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实凭据。

# 数据库连接串（PostgreSQL）
DB=postgresql://user:password@localhost:5432/oh-my-music-bank

# JWT 签名密钥：必填，至少 32 字节。运行 openssl rand -hex 32 生成后填入。
# 开发环境也必须设置；不要使用固定示例值或提交真实密钥。
JWT_SECRET=

# S3 兼容对象存储
S3_ENDPOINT=https://cn-nb1.rains3.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 公共桶只存封面，允许匿名 GetObject；私有桶存音频、原始文件和暂存文件。
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# 公共桶或 CDN 的 HTTPS 访问前缀。
S3_PUBLIC_BASE_URL=https://your-public-bucket.cn-nb1.rains3.com
# 私有音频临时地址有效期；不宜超过业务实际需要。
OMMB_STORAGE_PRESIGNED_URL_TTL=30m

# 可选：覆盖服务端口
# OMMB_SERVER_PORT=9111
