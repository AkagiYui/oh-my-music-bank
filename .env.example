# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实凭据。

# 数据库连接串（PostgreSQL）
DB=postgresql://user:password@localhost:5432/oh-my-music-bank

# JWT 签名密钥：必填，至少 32 字节。运行 openssl rand -hex 32 生成后填入。
# 开发环境也必须设置；不要使用固定示例值或提交真实密钥。
JWT_SECRET=

# S3 兼容对象存储：公共桶与私有桶分别使用独立的 endpoint 与凭据，互不共享。
# 公共桶只存封面与头像，允许匿名 GetObject；其 AK/SK 只需该桶的读写删权限。
S3_PUBLIC_ENDPOINT=https://cn-nb1.rains3.com
S3_PUBLIC_ACCESS_KEY=
S3_PUBLIC_SECRET_KEY=
S3_PUBLIC_BUCKET=
S3_PUBLIC_REGION=
# 公共桶或 CDN 的 HTTPS 访问前缀。
S3_PUBLIC_BASE_URL=https://your-public-bucket.cn-nb1.rains3.com

# 私有桶存音频、原始文件和暂存文件，不设匿名策略；其 AK/SK 只需该桶的读写删权限。
S3_PRIVATE_ENDPOINT=https://cn-nb1.rains3.com
S3_PRIVATE_ACCESS_KEY=
S3_PRIVATE_SECRET_KEY=
S3_PRIVATE_BUCKET=
S3_PRIVATE_REGION=
# 私有音频临时地址有效期；不宜超过业务实际需要。
S3_PRIVATE_PRESIGNED_URL_TTL=30m

# 可选：覆盖服务端口
# OMMB_SERVER_PORT=9111
